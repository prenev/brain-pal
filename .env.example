# Leave empty to run fully local (data stays in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Web Push public key (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
# Optional sign-in buttons: comma list of providers you've enabled in Supabase (google,apple)
VITE_OAUTH_PROVIDERS=
