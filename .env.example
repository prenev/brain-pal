# Leave empty to run fully local (data stays in this browser).
# Cloud sync: Supabase dashboard -> Project Settings -> API. Use the PUBLISHABLE key (sb_publishable_...) or the legacy "anon" key.
# NEVER put the secret / service_role key here - it would ship to every user's browser/phone. Check with: npm run check:supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Web Push public key (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
# Optional sign-in buttons: comma list of providers you've enabled in Supabase (google,apple)
VITE_OAUTH_PROVIDERS=
