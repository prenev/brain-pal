{
  "name": "brain-pal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "icons": "node scripts/make-icons.mjs",
    "screens": "node scripts/screens.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test": "node scripts/run-tests.mjs",
    "ios:sync": "npm run build && npx cap sync ios && python3 scripts/ios-patch.py",
    "ios:apple": "python3 scripts/ios-patch.py --apple-signin",
    "ios:screentime": "python3 scripts/ios-patch.py --screentime",
    "widget:assets": "node --no-warnings --experimental-strip-types scripts/widget-assets.mjs",
    "ios:open": "npx cap open ios",
    "check:supabase": "node scripts/check-supabase.mjs",
    "test:db": "node scripts/test-db.mjs",
    "site": "node scripts/make-site.mjs",
    "store:screens": "node scripts/make-appstore-screenshots.mjs",
    "store:check": "node scripts/check-store.mjs",
    "sprites": "node scripts/make-pal-sprites.mjs",
    "wardrobe": "node scripts/make-wardrobe.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/nunito": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.45.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "workbox-precaching": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@iconify-json/fluent-emoji": "^1.2.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5"
  }
}
